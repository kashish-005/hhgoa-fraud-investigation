// HHGoa Fraud Investigation - Part 1 graph schema.
// No agent, GraphRAG, MCP orchestration, or final NBA logic is included here.

CREATE VERTEX Customer (
  PRIMARY_ID customer_id STRING,
  n_cards UINT
) WITH primary_id_as_attribute="true";

CREATE VERTEX Card (
  PRIMARY_ID card_id STRING,
  customer_id STRING,
  k_number UINT,
  card2 STRING,
  card3 STRING,
  card4 STRING,
  card5 STRING,
  card6 STRING
) WITH primary_id_as_attribute="true";

CREATE VERTEX Transaction (
  PRIMARY_ID transaction_id STRING,
  customer_id STRING,
  card_id STRING,
  ts DATETIME,
  transaction_dt UINT,
  amount FLOAT,
  product_cd STRING,
  channel STRING,
  risk_score FLOAT,
  addr1 STRING,
  addr2 STRING,
  dist1 FLOAT,
  dist2 FLOAT,
  purchaser_email STRING,
  recipient_email STRING,
  device_profile_id STRING,
  has_device_record BOOL
) WITH primary_id_as_attribute="true";

CREATE VERTEX DeviceProfile (
  PRIMARY_ID device_profile_id STRING,
  device_info STRING,
  os STRING,
  browser STRING,
  screen STRING
) WITH primary_id_as_attribute="true";

CREATE VERTEX EmailDomain (
  PRIMARY_ID domain STRING
) WITH primary_id_as_attribute="true";

CREATE VERTEX BillingRegion (
  PRIMARY_ID region_id STRING,
  country_code STRING
) WITH primary_id_as_attribute="true";

CREATE VERTEX ClosedCase (
  PRIMARY_ID case_id STRING,
  customer_id STRING,
  card_id STRING,
  opened_at DATETIME,
  closed_at DATETIME,
  outcome STRING,
  pattern STRING,
  first_fraud_txn_id STRING,
  n_txns UINT,
  exposure_usd FLOAT,
  report_filed BOOL,
  actions_taken STRING,
  analyst_notes STRING
) WITH primary_id_as_attribute="true";

CREATE DIRECTED EDGE OWNS (FROM Customer, TO Card);
CREATE DIRECTED EDGE MADE (FROM Card, TO Transaction);
CREATE DIRECTED EDGE FROM_DEVICE (FROM Transaction, TO DeviceProfile);
CREATE DIRECTED EDGE PURCHASER_EMAIL (FROM Transaction, TO EmailDomain);
CREATE DIRECTED EDGE BILLED_IN (FROM Transaction, TO BillingRegion);
CREATE DIRECTED EDGE NEXT_TRANSACTION (FROM Transaction, TO Transaction);
CREATE DIRECTED EDGE INVOLVES (FROM ClosedCase, TO Transaction);
CREATE DIRECTED EDGE ON_CARD (FROM ClosedCase, TO Card);
CREATE DIRECTED EDGE CONNECTED_TO (FROM ClosedCase, TO Card);

CREATE GRAPH HHGoaFraudGraph(
  Customer, Card, Transaction, DeviceProfile, EmailDomain, BillingRegion, ClosedCase,
  OWNS, MADE, FROM_DEVICE, PURCHASER_EMAIL, BILLED_IN, NEXT_TRANSACTION,
  INVOLVES, ON_CARD, CONNECTED_TO
);
